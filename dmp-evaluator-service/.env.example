# Copy this file to .env (same directory) before running `docker-compose up -d`.
# .env is git-ignored — your real values never get committed.

# Required — generate with: openssl rand -base64 32
JWT_SECRET=

# Required — password for the bootstrap admin client created on first startup
ADMIN_CLIENT_SECRET=

# Required — base URLs the service uses to build its own endpoint links
TEST_URL=http://localhost:8080/tests
METRIC_URL=http://localhost:8080/metrics
BENCHMARK_URL=http://localhost:8080/benchmarks

# Optional — defaults shown; uncomment to override
# ADMIN_CLIENT_ID=admin
# ADMIN_DISPLAY_NAME=System Administrator
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_CAPACITY=100
# RATE_LIMIT_REFILL_TOKENS=100
# RATE_LIMIT_REFILL_DURATION_SECONDS=60
